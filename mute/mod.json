{
  "id": "neev-carplay-mute-pause",
  "version": "1.1.2",
  "name": "CarPlay Mute Pause",
  "authors": [
    "by blackr"
  ],
  "description": "Pause and resume CarPlay audio with the vehicle mute control. Compatible head units only. by blackr.",
  "license": "AGPL-3.0",
  "hmgapi": ">=1.0.1",
  "system": {
    "platform": "tcc803x",
    "android": "4.4.2"
  },
  "hooks": {
    "jar": "hooks.jar",
    "entry": "kr.ioniq5.mutepause.MutePause",
    "points": {
      "framework.hkmc_loader.automotive_service": "observe",
      "framework.window_manager_service.intercept_key": "observe",
      "dipo.carplay.session_started": "observe",
      "dipo.carplay.session_created": "observe",
      "dipo.carplay.session_finalized": "observe"
    }
  }
}
