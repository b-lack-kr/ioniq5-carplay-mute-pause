[nemesis]
version=1.1
id=hmgapi.neev-carplay-mute-pause
name=CarPlay Mute Pause
type=application
package-version=1.1.2
short-desc="Pause music on mute and resume when sound returns. by blackr."
detailed-desc="Control CarPlay music playback with vehicle mute and volume controls. Reboot after installation or removal. by blackr."
os=any
models="any"
depends="hmgapi@>=1.0"
preinstall=scripts/preinstall.sh
postinstall=scripts/postinstall.sh
preuninstall=scripts/preuninstall.sh

[app.0]
kind=sh
path=bin/open.sh
uid=root
